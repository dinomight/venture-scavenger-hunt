# ==============================================================================
# Venture Compound Scavenger Hunt - Environment Configuration
# ==============================================================================

# 1. Database (Turso / libSQL for production deployment on Vercel)
# Local development defaults to 'file:local.db' if DATABASE_URL is unset.
# For Vercel production: Create a free database at https://turso.tech
DATABASE_URL="libsql://your-database-name.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# 2. Vercel Blob Storage
# Automatically injected by Vercel when you connect a Blob store in the Vercel Storage dashboard.
# (Optional for local development; app will fallback to local data-URLs if not present)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
